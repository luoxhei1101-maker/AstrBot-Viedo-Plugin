# 插件运行时产物
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 虚拟环境
.venv/
venv/
env/

# 运行期数据（AstrBot 会把这些放在 data/ 下，不该进仓库）
*.log
logs/
temp/
cache/
downloads/
# ⚠️ data/cmd_config.json 是 AstrBot 的**宿主侧**配置（含 WebUI 密码哈希、
# t2i 模板），本地开发时 AstrBot 会把它生成在 cwd 下。绝不能进仓库。
data/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# 本地改配置/改 schema 前的临时备份
*.bak
*.bak-*
*.orig
